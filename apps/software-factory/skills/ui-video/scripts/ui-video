#!/usr/bin/env bash
# Records the virtual desktop Pi drives with the computer tool, with a caption burned in for each step, narrated.
#   ui-video start [--mute]  start recording the desktop
#   ui-video step "<text>"   caption from now until the next step, read aloud; waits until it's been said
#                            (the computer tool does this with each title)
#   ui-video stop <out.mp4>  stop, burn the captions in, add the narration, and fit the mp4 under 4 MB
# The narrator is a speech model on AI Gateway: UI_VIDEO_VOICE_MODEL (openai/tts-1) with UI_VIDEO_VOICE (nova).
# --mute, or UI_VIDEO_VOICE=off, records captions only. If a line can't be spoken, it's captioned only.
set -euo pipefail
DIR="${UI_VIDEO_DIR:-/tmp/ui-video}"
DISPLAY_ID="${COMPUTER_DISPLAY:-:99}"
SIZE="${COMPUTER_SIZE:-1280x800}"
LIMIT=$((4 * 1000 * 1000))
GATEWAY="${UI_VIDEO_GATEWAY:-https://ai-gateway.vercel.sh/v3/ai}"
# How long the take shows each step after its line is said: enough to see the action and its result.
HOLD="${UI_VIDEO_HOLD:-4}"
# How long the last step stays on screen at least, when stop comes right after it.
LAST="${UI_VIDEO_LAST:-2.5}"
now() { date +%s.%N; }
since_start() { awk -v a="$(cat "$DIR/start")" -v b="$(now)" 'BEGIN { printf "%.3f", b - a }'; }

# Speaks $1 into $2 (an mp3) with AI Gateway's speech model API; fails if it can't.
speak() {
  local body
  body=$(TEXT="$1" VOICE="${UI_VIDEO_VOICE:-nova}" node -e \
    'process.stdout.write(JSON.stringify({ text: process.env.TEXT, voice: process.env.VOICE, outputFormat: "mp3" }))')
  curl -fsS --max-time 30 "$GATEWAY/speech-model" \
    -H "Authorization: Bearer ${AI_GATEWAY_API_KEY:-}" -H "Content-Type: application/json" \
    -H "ai-gateway-protocol-version: 0.0.1" -H "ai-gateway-auth-method: api-key" \
    -H "ai-speech-model-specification-version: 4" -H "ai-model-id: ${UI_VIDEO_VOICE_MODEL:-openai/tts-1}" \
    -d "$body" | node -e '
      let s = ""; process.stdin.on("data", (d) => (s += d)).on("end", () => {
        const { audio } = JSON.parse(s);
        if (!audio) process.exit(1);
        require("fs").writeFileSync(process.argv[1], Buffer.from(audio, "base64"));
      })' "$2"
}

# The length of an audio file in seconds, from ffmpeg's header dump.
duration() {
  { ffmpeg -nostdin -hide_banner -i "$1" 2>&1 || true; } | awk -F'[:, ]+' '/Duration:/ { print $3 * 3600 + $4 * 60 + $5; exit }'
}

srt_time() { # seconds -> HH:MM:SS,mmm
  awk -v t="$1" 'BEGIN { if (t < 0) t = 0; ms = int(t * 1000 + 0.5);
    printf "%02d:%02d:%02d,%03d", int(ms / 3600000), int(ms / 60000) % 60, int(ms / 1000) % 60, ms % 1000 }'
}

case "${1:-}" in
  start)
    # A take started over without stop: end its recording, or it would run for the rest of the session.
    [ -f "$DIR/pid" ] && kill -TERM "$(cat "$DIR/pid")" 2>/dev/null || true
    rm -rf "$DIR" && mkdir -p "$DIR"
    shift
    for a in "$@"; do
      case "$a" in --mute) touch "$DIR/mute" ;; *) echo "usage: ui-video start [--mute]" >&2; exit 1 ;; esac
    done
    [ "${UI_VIDEO_VOICE:-}" = off ] && touch "$DIR/mute"
    # The same desktop the computer tool starts, if it hasn't yet.
    if [ ! -e "/tmp/.X11-unix/X${DISPLAY_ID#:}" ]; then
      setsid Xvfb "$DISPLAY_ID" -screen 0 "${SIZE}x24" -nolisten tcp >/dev/null 2>&1 < /dev/null &
      for _ in $(seq 50); do [ -e "/tmp/.X11-unix/X${DISPLAY_ID#:}" ] && break; sleep 0.1; done
    fi
    # Lossless-ish and cheap now; stop does the real encode. mkv survives being stopped mid-write.
    setsid ffmpeg -nostdin -loglevel error -y -f x11grab -framerate 15 -video_size "$SIZE" -i "$DISPLAY_ID" \
      -c:v libx264 -preset ultrafast -crf 18 "$DIR/raw.mkv" > "$DIR/ffmpeg.log" 2>&1 < /dev/null &
    echo $! > "$DIR/pid"
    now > "$DIR/start"
    : > "$DIR/steps.tsv"
    touch "$DIR/recording"
    sleep 0.5
    kill -0 "$(cat "$DIR/pid")" 2>/dev/null || { echo "the recording didn't start: $(cat "$DIR/ffmpeg.log")" >&2; rm -f "$DIR/recording"; exit 1; }
    echo "recording the desktop; each computer call's title is its caption"
    ;;
  step)
    [ -f "$DIR/recording" ] || { echo "not recording: run ui-video start first" >&2; exit 1; }
    shift
    text="$*"
    [ -n "$text" ] || { echo "usage: ui-video step \"<text>\"" >&2; exit 1; }
    at=$(since_start)
    printf '%s\t%s\n' "$at" "${text//$'\t'/ }" >> "$DIR/steps.tsv"
    [ -f "$DIR/mute" ] && exit 0
    # The line plays from when the step started; wait until it's been said, so the action follows it.
    n=$(wc -l < "$DIR/steps.tsv" | tr -d ' ')
    clip="$DIR/voice-$n.mp3"
    if speak "$text" "$clip.tmp" && len=$(duration "$clip.tmp") && [ -n "$len" ]; then
      mv "$clip.tmp" "$clip"
      printf '%s\t%s\t%s\n' "$n" "$clip" "$len" >> "$DIR/voice.tsv"
      left=$(awk -v at="$at" -v len="$len" -v now="$(since_start)" 'BEGIN { d = at + len - now; printf "%.3f", (d > 0 ? d : 0) }')
      sleep "$left"
    else
      rm -f "$clip.tmp"
      echo "couldn't narrate \"$text\": it's captioned only" >&2
    fi
    ;;
  stop)
    out="${2:?usage: ui-video stop <out.mp4>}"
    [ -f "$DIR/recording" ] || { echo "not recording: run ui-video start first" >&2; exit 1; }
    # The last step usually comes right before stop: keep recording until it's been on screen for a moment.
    last=$(tail -n 1 "$DIR/steps.tsv" | cut -f 1)
    wait=$(awk -v l="${last:-0}" -v n="$(since_start)" -v h="$LAST" 'BEGIN { w = l + h - n; printf "%.3f", (w > 0 ? w : 0) }')
    sleep "$wait"
    end=$(since_start)
    rm -f "$DIR/recording"
    pid=$(cat "$DIR/pid")
    kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 100); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
    [ -s "$DIR/raw.mkv" ] || { echo "the recording failed: $(cat "$DIR/ffmpeg.log")" >&2; exit 1; }
    # The take keeps each step from its start while its line is said and for HOLD seconds more (the action and
    # what it did), and cuts the rest: the screen sits still while Pi thinks. Captions and spoken lines are timed
    # on the cut take, one per kept stretch.
    declare -A clips=() said=()
    if [ -s "$DIR/voice.tsv" ]; then
      while IFS=$'\t' read -r i clip len; do clips[$i]="$clip"; said[$i]="$len"; done < "$DIR/voice.tsv"
    fi
    n=0; cut=0; keep=""; audio=(); mix=""; voices=0
    : > "$DIR/captions.srt"
    mapfile -t lines < "$DIR/steps.tsv"
    for i in "${!lines[@]}"; do
      from="${lines[$i]%%$'\t'*}"; text="${lines[$i]#*$'\t'}"
      if [ $((i + 1)) -lt ${#lines[@]} ]; then next="${lines[$((i + 1))]%%$'\t'*}"; else next="$end"; fi
      to=$(awk -v a="$from" -v b="$next" -v h="$HOLD" -v s="${said[$((i + 1))]:-0}" 'BEGIN { printf "%.3f", (b < a + s + h) ? b : a + s + h }')
      len=$(awk -v a="$from" -v b="$to" 'BEGIN { printf "%.3f", b - a }')
      awk -v l="$len" 'BEGIN { exit !(l > 0.05) }' || continue
      n=$((n + 1))
      if [ -n "${clips[$((i + 1))]:-}" ]; then
        voices=$((voices + 1))
        audio+=(-i "${clips[$((i + 1))]}")
        mix+="[$voices:a]adelay=$(awk -v t="$cut" 'BEGIN { printf "%d", t * 1000 }'):all=1[v$voices];"
      fi
      keep="${keep:+$keep+}between(t\,$from\,$to)"
      printf '%d\n%s --> %s\n%s\n\n' "$n" "$(srt_time "$cut")" "$(srt_time "$(awk -v c="$cut" -v l="$len" 'BEGIN { print c + l }')")" "$text" >> "$DIR/captions.srt"
      cut=$(awk -v c="$cut" -v l="$len" 'BEGIN { printf "%.3f", c + l }')
    done
    [ -n "$keep" ] && trim="select=$keep,setpts=N/FRAME_RATE/TB," || { trim=""; cut="$end"; }
    if [ "$voices" -gt 0 ]; then
      for v in $(seq 1 "$voices"); do mix+="[v$v]"; done
      mix+="amix=inputs=$voices:normalize=0:duration=longest[a]"
      sound=(-filter_complex "$mix" -map 0:v -map "[a]" -c:a aac -b:a 64k -ac 1)
    else
      sound=(-an)
    fi
    style="FontName=Liberation Sans,FontSize=12,PrimaryColour=&H00FFFFFF,OutlineColour=&H40000000,BackColour=&H40000000,BorderStyle=3,Outline=4,Shadow=0,MarginV=16"
    # Smaller and blurrier each try until it fits under the board's 4 MB.
    for try in "1280 28" "1280 33" "960 35" "720 38"; do
      set -- $try
      ffmpeg -nostdin -loglevel error -y -i "$DIR/raw.mkv" "${audio[@]}" \
        -vf "${trim}scale='min($1,iw)':-2,subtitles=$DIR/captions.srt:force_style='$style'" \
        -c:v libx264 -preset veryfast -crf "$2" -pix_fmt yuv420p -movflags +faststart "${sound[@]}" "$out"
      size=$(stat -c %s "$out")
      if [ "$size" -le "$LIMIT" ]; then
        echo "$out: $((size / 1000)) KB, ${n} captions, ${voices} narrated, ${cut%.*}s (of ${end%.*}s recorded)"
        exit 0
      fi
    done
    echo "$out is still over 4 MB ($((size / 1000)) KB): record a shorter take" >&2
    exit 1
    ;;
  *)
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
